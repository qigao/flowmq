// FlowMQ media-provider v1 canonical application contract.
//
// FMP/1 is transport-neutral application data carried inside an FMQ/6 DATA
// frame. FlowMQ admission is not a durable receipt: ProviderReceiptV1,
// ProviderCompletionAckV1, and ProviderEventAckV1 close the application-level
// delivery states. Ack sequence fields identify the committed session inbox
// event. All values that can exceed JSON's exact integer range are
// decimal strings and must be range-checked by the receiving adapter.

schema FlowMqMediaProviderV1 [id(22001), byte_order(little)];

// Every payload starts with schema_version + message_kind. Consumers must
// route on this fixed prefix before invoking the message-specific decoder.
enum ProviderMessageKind <uint8> {
  Command = 1;
  Receipt = 2;
  Completion = 3;
  Event = 4;
  EventAck = 5;
  Query = 6;
  Observation = 7;
  CallOffer = 8;
  SessionBound = 9;
  CompletionAck = 10;
}

enum ProviderReceiptDisposition <uint8> {
  DurableAccepted = 1;
  Duplicate = 2;
  Rejected = 3;
  Conflict = 4;
  NotReady = 5;
  CapacityExceeded = 6;
}

enum ProviderTerminalStatus <uint8> {
  Succeeded = 1;
  Failed = 2;
  Canceled = 3;
  Unknown = 4;
  TimedOut = 5;
}

enum ProviderEventAckDisposition <uint8> {
  Committed = 1;
  DuplicateEvent = 2;
  EventConflict = 3;
  EventRejected = 4;
}

enum ProviderCompletionAckDisposition <uint8> {
  CompletionCommitted = 1;
  DuplicateCompletion = 2;
  CompletionConflict = 3;
  CompletionRejected = 4;
}

enum ProviderQueryStatus <uint8> {
  QueryOk = 1;
  QueryNotReady = 2;
  QueryConflict = 3;
  QueryRejected = 4;
}

[id(1001)]
message ProviderCommandV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string command_id;
  string command_type;
  string worker_id;
  string dispatch_epoch;
  string semantic_fingerprint;
  string payload_json;
}

[id(2001)]
message ProviderReceiptV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  ProviderReceiptDisposition disposition;
  int32 status_code;
  uint32 retry_after_ms;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string command_id;
  string worker_id;
  string dispatch_epoch;
  string error_code;
  string error_message;
}

[id(2002)]
message ProviderCompletionV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  ProviderTerminalStatus terminal_status;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string command_id;
  string worker_id;
  string dispatch_epoch;
  string event_id;
  string event_type;
  string completed_at;
  string completed_at_unix_ms;
  string result_json;
  string error_code;
  string error_message;
}

[id(2003)]
message ProviderCompletionAckV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  ProviderCompletionAckDisposition disposition;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string command_id;
  string dispatch_epoch;
  string committed_sequence;
  string error_code;
  string error_message;
}

[id(3001)]
message ProviderEventV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string event_id;
  string event_type;
  string aggregate_id;
  string sequence;
  string occurred_at;
  string payload_json;
}

[id(3002)]
message ProviderEventAckV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  ProviderEventAckDisposition disposition;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string event_id;
  string committed_sequence;
  string error_code;
  string error_message;
}

[id(4001)]
message ProviderQueryV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  uint32 limit;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string query_id;
  string query_type;
  string expected_revision;
  string cursor;
  string payload_json;
}

[id(4002)]
message ProviderObservationV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  ProviderQueryStatus status;
  // Logical boolean encoded as 0 or 1. Header-only SaltsUtils TBE contracts
  // intentionally use only standalone fixed-width C types.
  uint8 has_more;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string query_id;
  string observation_type;
  string revision;
  string cursor;
  string next_cursor;
  string payload_json;
  string error_code;
  string error_message;
}

[id(5001)]
message ProviderCallOfferV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string ingress_event_id;
  string call_id;
  string call_generation;
  string transport;
  string source;
  string destination;
  string payload_json;
}

[id(5002)]
message ProviderSessionBoundV1 {
  uint32 schema_version;
  ProviderMessageKind message_kind;
  // Logical boolean encoded as 0 or 1; the validator rejects other values.
  uint8 accepted;
  string message_id;
  string correlation_id;
  string causation_id;
  string tenant_id;
  string provider_id;
  string session_id;
  string partition_key;
  string producer_id;
  string created_at;
  string deadline_at;
  string ingress_event_id;
  string call_id;
  string call_generation;
  string bound_session_id;
  string error_code;
  string error_message;
}
