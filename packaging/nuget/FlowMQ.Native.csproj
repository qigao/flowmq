<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>FlowMQ.Native</PackageId>
    <Authors>qigao</Authors>
    <Description>FlowMQ native C SDK for Linux x64, Windows x64, macOS host architecture, and Android arm64-v8a Release builds.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qigao/flowmq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/qigao/flowmq</PackageProjectUrl>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Salts.Native" Version="2.3.0-*" />
    <PackageReference Include="SaltsUtils.Native" Version="4.3.0-*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackageRoot)/sdk/**/*" Pack="true" PackagePath="sdk/" />
  </ItemGroup>
  <!-- CI selects the latest official rc.N/stable from GitHub Releases.
       Normal PackageReference remains 2.3.0-*; this override excludes
       incomplete historical rc.sha integration packages from qualification. -->
  <ItemGroup Condition="'$(FlowMQSaltsReleaseVersion)' != ''">
    <PackageReference Update="Salts.Native" Version="$(FlowMQSaltsReleaseVersion)" />
  </ItemGroup>
</Project>
