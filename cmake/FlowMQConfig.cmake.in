@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SaltsBase @FLOWMQ_BASE_VERSION@ EXACT CONFIG
                PATHS "$ENV{SALTS_BASE_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(CMeta @FLOWMQ_CMETA_VERSION@ EXACT CONFIG
                PATHS "$ENV{CMETA_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsCore @FLOWMQ_CNET_VERSION@ EXACT CONFIG
                PATHS "$ENV{SALTSCORE_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils @FLOWMQ_UTILS_VERSION@ EXACT CONFIG
                PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/FlowMQTargets.cmake")
# Let linkers resolve FlowMQ's private shared-library dependency without
# propagating CNet's headers or compile options to FlowMQ callers.
set_property(TARGET FlowMQ::FlowMQ PROPERTY IMPORTED_LINK_DEPENDENT_LIBRARIES
             Salts::CNet)

set(FlowMQ_FlowMQ_FOUND TRUE)
check_required_components(FlowMQ)
