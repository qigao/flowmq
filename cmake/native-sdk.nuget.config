<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="qigao" value="https://nuget.pkg.github.com/qigao/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <qigao>
      <add key="Username" value="qigao" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </qigao>
  </packageSourceCredentials>
</configuration>
