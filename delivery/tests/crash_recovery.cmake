string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run_id)
set(outbox "${CMAKE_CURRENT_BINARY_DIR}/outbox-${run_id}.db")
set(inbox "${CMAKE_CURRENT_BINARY_DIR}/inbox-${run_id}.db")
foreach(phase IN ITEMS enqueue receive abort-business commit-business settle verify)
  execute_process(COMMAND "${NODE}" "${phase}" "${outbox}" "${inbox}"
                  RESULT_VARIABLE status TIMEOUT 20)
  if(phase STREQUAL "verify")
    set(expected 0)
  else()
    set(expected 42)
  endif()
  if(NOT "${status}" STREQUAL "${expected}")
    message(FATAL_ERROR "${phase} exited ${status}, expected ${expected}. Stores: ${outbox}, ${inbox}")
  endif()
endforeach()
foreach(store IN ITEMS "${outbox}" "${inbox}")
  file(REMOVE "${store}" "${store}-wal" "${store}-shm")
endforeach()
