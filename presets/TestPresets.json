{
  "version": 6,
  "include": [
    "ConfigurePresets.json"
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "displayName": "Base Test Preset",
      "description": "Base configuration for running tests",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-dev-windows",
      "displayName": "Developer Windows Tests",
      "inherits": "base-test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "configurePreset": "dev-win-msvc-ninja"
    },
    {
       "name": "test-release-windows",
       "displayName": "Release Windows Tests",
       "inherits": "base-test",
       "condition": {
         "type": "equals",
         "lhs": "${hostSystemName}",
         "rhs": "Windows"
       },
       "configurePreset": "release-win-msvc-ninja"
    },
    {
       "name": "test-dev-linux",
       "displayName": "Developer Linux Tests",
       "inherits": "base-test",
       "condition": {
         "type": "equals",
         "lhs": "${hostSystemName}",
         "rhs": "Linux"
       },
       "configurePreset": "dev-linux-ninja"
    },
    {
       "name": "test-release-linux",
       "displayName": "Release Linux Tests",
       "inherits": "base-test",
       "condition": {
         "type": "equals",
         "lhs": "${hostSystemName}",
         "rhs": "Linux"
       },
       "configurePreset": "release-linux-ninja"
    }
  ]
}
